# Заполняется в Vercel → Project → Settings → Environment Variables. В репо не коммитить.
TELEGRAM_BOT_TOKEN=
# любая длинная случайная строка
TELEGRAM_WEBHOOK_SECRET=
# числовой id @Aleron_df
OWNER_USER_ID=
# id канала aleron_saas, вида -100...
CHANNEL_SAAS_ID=
# id новой таблицы "CRM студентов" (из её URL)
CRM_SPREADSHEET_ID=
# JSON ключа сервисного аккаунта Google одной строкой
GOOGLE_SERVICE_ACCOUNT_JSON=
# Vercel сам подставляет его в заголовок Authorization для крона
CRON_SECRET=
